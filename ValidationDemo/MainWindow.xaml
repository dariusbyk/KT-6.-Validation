<Window x:Class="ValidationDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка данных"
        Width="460"
        Height="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="ErrorTemplate">
            <TextBlock Text="{Binding ErrorContent}"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="Данные пользователя"
                       FontSize="22"
                       Margin="0,0,0,20" />

            <TextBlock Text="Email:" />

            <TextBox x:Name="EmailTextBox"
                     Margin="0,5,0,0"
                     FontSize="16"
                     Text="{Binding Email,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />

            <ItemsControl
                ItemsSource="{Binding ElementName=EmailTextBox,
                                      Path=(Validation.Errors)}"
                ItemTemplate="{StaticResource ErrorTemplate}" />

            <TextBlock Text="Пароль — минимум 6 символов:"
                       Margin="0,15,0,0" />

            <TextBox x:Name="PasswordTextBox"
                     Margin="0,5,0,0"
                     FontSize="16"
                     Text="{Binding Password,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />

            <ItemsControl
                ItemsSource="{Binding ElementName=PasswordTextBox,
                                      Path=(Validation.Errors)}"
                ItemTemplate="{StaticResource ErrorTemplate}" />

            <TextBlock Text="Возраст — от 18 до 100:"
                       Margin="0,15,0,0" />

            <TextBox x:Name="AgeTextBox"
                     Margin="0,5,0,0"
                     FontSize="16"
                     Text="{Binding Age,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True}" />

            <ItemsControl
                ItemsSource="{Binding ElementName=AgeTextBox,
                                      Path=(Validation.Errors)}"
                ItemTemplate="{StaticResource ErrorTemplate}" />

            <Button Content="Проверить данные"
                    Height="35"
                    Margin="0,25,0,0"
                    Click="Submit_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>